# Copia este archivo como "backend/.env" y completa tus datos. El .env NO se sube al repo.
# (este archivo de ejemplo si se sube: no tiene datos reales)

# Contraseña del usuario ilmagro que creaste con db/crear-base.sql
DB_PASSWORD=

# Opcionales (ya tienen valor por defecto):
# DB_URL=jdbc:postgresql://localhost:5432/ilmagro
# DB_USER=ilmagro

# Aviso por email a Luca cuando alguien reserva (Brevo, plan gratis: 300 mails por dia).
# En Brevo: Settings > SMTP & API > SMTP. El usuario es tipo "xxxx@smtp-brevo.com" y la clave es
# la "SMTP key" que generas ahi (NO la contraseña de tu cuenta de Brevo).
# AVISO_EMAIL_PARA=mail-de-luca@ejemplo.com
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USER=xxxx@smtp-brevo.com
# MAIL_PASSWORD=la-smtp-key-de-brevo
# MAIL_FROM=el-remitente-que-verificaste-en-brevo@ejemplo.com

# Direccion publica del sitio, para el link de cancelacion que va en el mail (por defecto localhost)
# SITIO_URL=https://tu-dominio.com.ar

# Panel de administracion (/admin): quienes pueden entrar. Son dos lugares, con el mismo permiso.
# Elegi usuario y una clave larga (minimo 10 caracteres) para cada uno. Una clave mas corta no se habilita.
# ADMIN_USUARIO_1=luca
# ADMIN_CLAVE_1=una-clave-larga-que-solo-sabe-luca
# ADMIN_USUARIO_2=dueno
# ADMIN_CLAVE_2=otra-clave-larga-distinta
